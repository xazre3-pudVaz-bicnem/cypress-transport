# ============================================================
# 環境変数サンプル
# 実際の値は .env.local（ローカル）/ Vercelの環境変数（本番）に設定する。
# 秘密情報は絶対にGitにコミットしないこと。
# ============================================================

# サイトURL（本番: https://www.cypress-transport.com）
# 未設定・空文字なら https://www.cypress-transport.com が使われる
NEXT_PUBLIC_SITE_URL=https://www.cypress-transport.com

# ── 応募フォームのメール送信（Resend: https://resend.com）──
# これを設定するだけで info@cypress-all.co.jp にフォームのメールが届く。
# 未設定の場合、開発環境ではコンソール出力のみ／本番ではフォームがエラーを返す。
RESEND_API_KEY=

# 以下2つは任意。未設定なら下記の既定値が使われる。
#
# 送信先（既定: info@cypress-all.co.jp）
CONTACT_EMAIL_TO=
# 送信元（既定: サイプレス軽貨物事業部 <no-reply@cypress-all.co.jp>）
# ⚠️ Resendで「検証済み」のドメインのアドレスしか使えません。
#    検証済み: cypress-all.co.jp ／ cypress-transport.com は未登録のため使用不可。
#    cypress-transport.com から送りたい場合は、先にResendでドメイン追加とDNS認証を行うこと。
CONTACT_EMAIL_FROM=

# ── GA4（設定すると計測開始。未設定なら何も読み込まれない）──
NEXT_PUBLIC_GA4_ID=

# ── Google Indexing API（scripts/notify-indexing.mjs 用・ローカルのみ）──
# ⚠️ 求人ページ（JobPosting）専用。記事や固定ページには使用不可
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ── IndexNow（Bing / Copilot など向け・scripts/indexnow.mjs 用）──
# 任意の英数字キー（8〜128文字）。次のコマンドで生成できます
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Vercel にも同じ値を登録すること（キー確認用の /<キー>.txt を返すため）
INDEXNOW_KEY=
