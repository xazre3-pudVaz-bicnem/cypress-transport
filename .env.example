# ============================================================
# 環境変数サンプル
# 実際の値は .env.local（ローカル）/ Vercelの環境変数（本番）に設定する。
# 秘密情報は絶対にGitにコミットしないこと。
# ============================================================

# サイトURL（本番: https://cypress-transport.com）
# 未設定時は https://cypress-transport.com がフォールバックとして使われる
NEXT_PUBLIC_SITE_URL=https://cypress-transport.com

# ── 応募フォームのメール送信（Resend: https://resend.com）──
# 3つすべて設定するとフォームからメールが届く。
# 未設定の場合、開発環境ではコンソール出力のみ／本番ではフォームがエラーを返す。
RESEND_API_KEY=
# 応募通知の受信先メールアドレス
CONTACT_EMAIL_TO=
# 送信元（Resendで認証したドメインのアドレス。例: no-reply@cypress-transport.com）
CONTACT_EMAIL_FROM=

# ── GA4（設定すると計測開始。未設定なら何も読み込まれない）──
NEXT_PUBLIC_GA4_ID=

# ── Google Indexing API（scripts/notify-indexing.mjs 用・ローカルのみ）──
# ⚠️ 求人ページ（JobPosting）専用。記事や固定ページには使用不可
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# ── IndexNow（Bing / Copilot など向け・scripts/indexnow.mjs 用）──
# 任意の英数字キー（8〜128文字）。次のコマンドで生成できます
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Vercel にも同じ値を登録すること（キー確認用の /<キー>.txt を返すため）
INDEXNOW_KEY=
